# Render Postgres: use a URL de conexão DATABASE_URL fornecida pelo Render.
DATABASE_URL=

# Senha forte do painel; nunca coloque no HTML ou no Git.
ADMIN_PASSWORD=

# Credencial de API PushinPay; o URL abaixo é API, não o portal app.pushinpay.com.br.
PUSHINPAY_TOKEN=
PUSHINPAY_API_URL=https://api.pushinpay.com.br

# Domínio público HTTPS do próprio site para configurar o webhook.
PUBLIC_BASE_URL=https://seu-dominio.example

# Brevo Transactional API; a chave deve ficar somente no ambiente do servidor.
# O e-mail do remetente precisa estar validado na Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Academia Gaviões
BREVO_REPLY_TO=
BREVO_SUPPORT_URL=https://wa.me/5511922214270

# Web Push (VAPID); gere um par e mantenha a chave privada somente no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seu-dominio.example

# A hospedagem Render fornece PORT automaticamente.
# PORT=3000
# PGSSLMODE=require somente se a conexão PostgreSQL usada exigir TLS.
